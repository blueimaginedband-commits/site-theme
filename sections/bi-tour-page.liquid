{%- comment -%}
  Blue Imagined Tour page: band photo beside a list of shows.
  Add each show as a "Show" block. With no shows, the "Coming soon" text and button appear instead.
{%- endcomment -%}

{{ 'section-bi-home.css' | asset_url | stylesheet_tag }}
{{ 'section-bi-pages.css' | asset_url | stylesheet_tag }}

{%- assign shows = section.blocks | where: 'type', 'show' -%}
{%- assign heading = section.settings.heading | default: page.title -%}

<div class="bi-home bi-page color-{{ section.settings.color_scheme }} gradient">
  <section class="bi-sec page-width">
    <div class="bi-sec__head bi-page__head">
      <h1>{{ heading | escape }}</h1>
      {%- if section.settings.label != blank -%}<p>{{ section.settings.label | escape }}</p>{%- endif -%}
    </div>

    <div class="bi-tourpage{% if section.settings.image == blank %} bi-tourpage--no-photo{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="bi-tourpage__photo">
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'eager', alt: section.settings.image.alt
          }}
        </div>
      {%- endif -%}

      <div class="bi-tourpage__body">
        {%- if shows.size > 0 -%}
          <ol class="bi-shows">
            {%- for block in shows -%}
              <li class="bi-show{% if block.settings.sold_out %} bi-show--sold-out{% endif %}" {{ block.shopify_attributes }}>
                <span class="bi-show__date">{{ block.settings.date | escape }}</span>
                <span class="bi-show__where">
                  <span class="bi-show__city">{{ block.settings.city | escape }}</span>
                  {%- if block.settings.venue != blank -%}<span class="bi-show__venue">{{ block.settings.venue | escape }}</span>{%- endif -%}
                </span>
                {%- if block.settings.sold_out -%}
                  <span class="bi-show__status">Sold out</span>
                {%- elsif block.settings.ticket_url != blank -%}
                  <a class="bi-pill" href="{{ block.settings.ticket_url }}" target="_blank" rel="noopener">{{ block.settings.ticket_label | default: 'Tickets' | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        {%- else -%}
          <div class="bi-tour bi-tour--stack">
            <p class="bi-tour__big">{{ section.settings.empty_heading | escape }}</p>
            {%- if section.settings.empty_text != blank -%}<div class="bi-tour__text">{{ section.settings.empty_text }}</div>{%- endif -%}
            {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
              <a class="bi-pill" href="{{ section.settings.button_url }}" {% if section.settings.button_url contains 'http' %}target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Blue Imagined tour",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "text", "id": "label", "label": "Small label", "default": "Live dates" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "header", "content": "When no shows are listed" },
    { "type": "text", "id": "empty_heading", "label": "Big text", "default": "Coming soon" },
    { "type": "richtext", "id": "empty_text", "label": "Text", "default": "<p>No shows announced yet. New dates go up on Instagram first.</p>" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Get notified" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "show",
      "name": "Show",
      "settings": [
        { "type": "text", "id": "date", "label": "Date", "placeholder": "Mar 14" },
        { "type": "text", "id": "city", "label": "City", "placeholder": "Los Angeles, CA" },
        { "type": "text", "id": "venue", "label": "Venue" },
        { "type": "url", "id": "ticket_url", "label": "Ticket link" },
        { "type": "text", "id": "ticket_label", "label": "Button text", "default": "Tickets" },
        { "type": "checkbox", "id": "sold_out", "label": "Sold out", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Blue Imagined tour" } ]
}
{% endschema %}
